PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase
# Leave these placeholders for local boot/health checks only.
# DB-backed routes return HTTP 503 until SUPABASE_URL and at least one key are valid.
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only key used by backend DB operations to bypass RLS for Phase 1 demo flows.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Redis Cache (optional)
# Leave empty to run without Redis caching.
REDIS_URL=

# OpenAI
# Leave as placeholder to use local development itinerary/message fallbacks.
OPENAI_API_KEY=your_openai_api_key

# Weather API
# Leave as placeholder to use local development weather fallback.
WEATHER_API_KEY=your_openweathermap_api_key

# Foursquare Places API
# Leave as placeholder to use local development places fallback.
FOURSQUARE_API_KEY=your_foursquare_api_key

# OpenRouteService
OPENROUTE_API_KEY=your_openroute_api_key

# Email Service (Mailjet/Sendinblue)
EMAIL_API_KEY=your_email_api_key
EMAIL_API_SECRET=your_email_api_secret
EMAIL_FROM=noreply@example.com
